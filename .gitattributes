# Automatically normalize text files
* text=auto

# Source code
*.py text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.json text eol=lf
*.dbml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary documents and images
*.pdf binary
*.docx binary
*.xlsx binary
*.png binary
*.jpg binary